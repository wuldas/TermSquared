<template>
  <View ref="Root" class="session-tabs">
    <View ref="SessionTabsHost" class="session-tabs-host" />
  </View>
</template>
<script lang="csharp" namespace="TermSquared.App.Components" name="SessionTabs" access="internal">
public static readonly ComponentEvent<Guid> SessionSelectedEvent = new("session-selected");
public static readonly ComponentEvent<Guid> SessionCloseRequestedEvent = new("session-close-requested");

public void RequestSessionSelected(Guid sessionId) => Emit(SessionSelectedEvent, sessionId);
public void RequestSessionClose(Guid sessionId) => Emit(SessionCloseRequestedEvent, sessionId);
</script>
<style>
  .session-tabs { display: flex; flex-direction: row; align-items: flex-end; width: 100%; height: 42px; min-width: 0; padding: 4px 8px 0 8px; gap: 6px; overflow: hidden; }
  .session-tabs-host { display: flex; flex-direction: row; width: auto; height: 38px; gap: 4px; }
</style>
